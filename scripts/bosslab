#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if ! command -v node >/dev/null 2>&1; then echo 'BossLab requires Node.js 22 or newer.' >&2; exit 1; fi
case "${1:-play}" in
 doctor) exec node scripts/doctor.mjs ;;
 play) exec node scripts/serve.mjs ;;
 demo) exec node scripts/serve.mjs --demo ;;
 test) exec node --test tests/*.test.mjs ;;
 evaluate) exec node scripts/evaluate.mjs ;;
 *) echo 'Usage: ./scripts/bosslab {doctor|play|demo|test|evaluate}' >&2; exit 1 ;;
esac
